{
  "name": "antigravity-weekly-quota",
  "displayName": "Antigravity 5h/Weekly Quota",
  "description": "Show Antigravity CLI five-hour and weekly quota with color indicators.",
  "version": "0.3.3",
  "publisher": "local-jerry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JerryGong1002/antigravity-weekly-quota.git"
  },
  "homepage": "https://github.com/JerryGong1002/antigravity-weekly-quota#readme",
  "bugs": {
    "url": "https://github.com/JerryGong1002/antigravity-weekly-quota/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "antigravity",
    "agy",
    "weekly quota",
    "gemini",
    "claude"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:antigravityWeeklyQuota.refresh",
    "onCommand:antigravityWeeklyQuota.showDetails"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravityWeeklyQuota.refresh",
        "title": "Antigravity 5h/Weekly Quota: Refresh"
      },
      {
        "command": "antigravityWeeklyQuota.showDetails",
        "title": "Antigravity 5h/Weekly Quota: Show Details"
      }
    ],
    "configuration": {
      "title": "Antigravity 5h/Weekly Quota",
      "properties": {
        "antigravityWeeklyQuota.refreshIntervalSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 60,
          "maximum": 3600,
          "description": "How often to refresh quota data."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package --no-dependencies",
    "test": "node --test test/*.test.js"
  }
}
